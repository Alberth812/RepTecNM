# -------------------------
# PostgreSQL
# -------------------------

DATABASE_URL=postgresql://your_user:change-me@postgres:5432/your_db_name

# -------------------------
# Auth
# -------------------------

# Genera un secreto fuerte, p.ej.: openssl rand -base64 32
BETTER_AUTH_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------
# Mailtrap
# -------------------------

# Sandbox de Mailtrap: https://mailtrap.io/ -> Email Testing -> SMTP Settings
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=user
MAILTRAP_PASS=password
MAILTRAP_FROM="Sistema de Egresados <no-responder@egresados.example.com>"

# --- Semilla del administrador raíz (solo para el script de seed) ---
ROOT_ADMIN_EMAIL="admin@example.com"
ROOT_ADMIN_PASSWORD="123456@Abcde"
ROOT_ADMIN_NAME="Administrador Raíz"

# -------------------------
# PostgreSQL
# -------------------------

DATABASE_URL=postgresql://your_user:change-me@postgres:5432/your_db_name

# -------------------------
# Auth
# -------------------------

# Genera un secreto fuerte, p.ej.: openssl rand -base64 32
BETTER_AUTH_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------
# Garage (file storage)
# -------------------------

GARAGE_DEFAULT_ACCESS_KEY=GKdev12345678901234567890
GARAGE_DEFAULT_SECRET_KEY=dev-secret-key-change-me-012345678901234567890123
GARAGE_DEFAULT_BUCKET=app-development

# -------------------------
# Trusted IP Header
# -------------------------

TRUSTED_IP_HEADER=x-real-ip

# -------------------------
# Mail (development)
# We don't need auth, so user and pass must be empty
# -------------------------

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost

# --- Semilla del administrador raíz (solo para el script de seed) ---
ROOT_ADMIN_EMAIL="admin@example.com"
ROOT_ADMIN_PASSWORD="123456@Abcde"
ROOT_ADMIN_NAME="Administrador Raíz"

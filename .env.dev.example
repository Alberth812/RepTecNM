# -------------------------
# PostgreSQL
# -------------------------

DATABASE_URL=postgresql://your_user:change-me@postgres:5432/your_db_name

# -------------------------
# Auth
# -------------------------

# Genera un secreto fuerte, p.ej.: openssl rand -base64 32
BETTER_AUTH_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio
BETTER_AUTH_URL=http://10.168.0.109.nip.io:3000
NEXT_PUBLIC_APP_URL=http://10.168.0.109.nip.io:3000

# -------------------------
# Garage (file storage)
# -------------------------

GARAGE_AFFILIATES_BUCKET=rep-afiliados-dev
GARAGE_CMS_BUCKET=rep-cms-dev

GARAGE_AFFILIATES_ACCESS_KEY="GK$(openssl rand -hex 16)"
GARAGE_AFFILIATES_SECRET_KEY="$(openssl rand -hex 32)"

GARAGE_CMS_ACCESS_KEY="GK$(openssl rand -hex 16)"
GARAGE_CMS_SECRET_KEY="$(openssl rand -hex 32)"

# -------------------------
# Payload
# -------------------------

PAYLOAD_SECRET=super-secret-secret-change-me
PAYLOAD_SERVER_URL=http://10.168.0.109.nip.io:3000
PAYLOAD_PREVIEW_SECRET=un-string-aleatorio-largo

# -------------------------
# Trusted IP Header
# -------------------------

TRUSTED_IP_HEADER=x-real-ip

# -------------------------
# Mail (development) 
# -------------------------

# In production, we'll use mailtrap or resend
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_SECURE=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost

# --- Semilla del administrador raíz (solo para el script de seed) ---
ROOT_ADMIN_EMAIL="admin@example.com"
ROOT_ADMIN_PASSWORD="123456@Abcde"
ROOT_ADMIN_NAME="Administrador Raíz"
